{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/avi-the-coach/agentic-skill-kit-agile-gov/skills/product-canvas/schemas/product-canvas.schema.json",
  "title": "Product Canvas",
  "type": "object",
  "required": ["metadata", "vision", "target_users", "problems_needs", "value_proposition"],
  "$defs": {
    "status": {
      "type": "string",
      "enum": ["evidence", "assumption", "unknown"]
    },
    "item": {
      "type": "object",
      "required": ["text", "status"],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "source": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "required": ["name", "status"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "baseline": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "timeframe": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["product_name", "version"],
      "properties": {
        "product_name": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "context": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "vision": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "target_users": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "problems_needs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "current_alternatives": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "value_proposition": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "business_outcomes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "success_metrics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "key_capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "assumptions_risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "additionalProperties": false
}
